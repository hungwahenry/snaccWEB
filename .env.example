# Copy to .env.local. Only NEXT_PUBLIC_* vars reach the browser.

# Backend API origin the Next.js server proxies to (no trailing slash). Server-side only.
SNACC_API_URL=http://localhost:3000

# Backend API origin the browser connects to for the realtime socket (no trailing slash).
# Same value as above in most setups; leave empty to run without realtime.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Where share links point. Defaults to https://snacc.fyi when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:4000
